{
  "name": "elysia",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "check:wallets": "node scripts/check-wallets.mjs",
    "telegram:test": "node scripts/telegram-test.mjs",
    "review:testnet": "node scripts/review-testnet.mjs",
    "indexer:local": "node scripts/indexer-local.mjs",
    "lint": "echo \"no lint targets yet\"",
    "typecheck": "pnpm -r --workspace-concurrency=1 --if-present typecheck",
    "build": "pnpm -r --workspace-concurrency=1 --if-present build",
    "test": "pnpm -r --workspace-concurrency=1 --if-present test",
    "test:scripts": "node --test scripts/lib/test-db-url.test.mjs",
    "test:non-db": "node scripts/run-tests.mjs",
    "test:db": "node scripts/run-tests.mjs --db",
    "push": "git push origin main",
    "push:dev-rh": "git push origin dev-rh",
    "prepare": "node -e \"try{require('child_process').execSync('git config --local core.hooksPath .githooks',{stdio:'ignore'})}catch{}\""
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "turbo": "^2.11.10",
    "viem": "^2.21.0"
  }
}

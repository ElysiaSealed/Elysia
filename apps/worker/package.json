    "drizzle-orm": "^0.36.0",
    "zod": "^3.23.8",
    "@elysia/contracts-abi": "workspace:*",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}

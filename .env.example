# Wallet (alamat publik saja; private key TIDAK pernah di file ini)
# Alamat publik wallet Elysia untuk dev-rh (Robinhood mainnet), diberikan developer 2026-11-13; JANGAN isi dengan alamat NEXA. KEEPER_ADDRESS belum diberikan.
# Treasury hanya untuk dev-rh (fitur berbayar). Di main tidak ada Treasury (keputusan FINAL).
DEPLOYER_ADDRESS=0x30E12875b1cc04cE06c4a889CDA435f475678D82
AGENT_ADDRESS=0x399c038d0946b358A94F3DDdeE64A87df051a9fC
KEEPER_ADDRESS=
TREASURY_ADDRESS=0x582660f6C3D5560D7797e1BC79DbB571Dd5a8121

# Chain
CHAIN_ENV=elysiumTestnet
# RPC URL of the chain you run against. Leave it unset; do NOT leave it empty (an empty value is invalid).
# - indexer: unset = RPC of CHAIN_ENV (CHAINS[CHAIN_ENV].rpc, Elysium Testnet by default).
# - worker: unset = Elysium Testnet RPC when CHAIN_ID is 99801 (the default). Any other CHAIN_ID needs RPC_URL set explicitly.
#   A URL that belongs to a different known chain than CHAIN_ID is rejected at startup.
# RPC_URL=

# Database
# Required, no default. Set to the URL of your dedicated ELYSIA database (never a shared or NEXA database).
DATABASE_URL=

# Posting
X_POST_MODE=dry
# Posting ke X (hanya dipakai bila X_POST_MODE=live). Kredensial OAuth 1.0a akun X ELYSIA (bukan akun NEXA): diisi pemilik di dashboard Railway, JANGAN di repo.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Batas jumlah post live sepanjang masa di database ini (0 = tidak ada; unlimited = tanpa batas, dinyalakan saat launch).
# Arahan head dev: uji testnet 2 post, mainnet 4 post, lalu berhenti sampai launch.
X_LIVE_POST_CAP=0
# Jeda minimum antar post live (menit). Arahan head dev: 30.
POST_INTERVAL_MINUTES=30
# Jenis post yang boleh keluar ke X, dipisah koma (kosong = semua): daily_summary, pons_report, pulse, prediction, mention_reply.
X_POST_KINDS=
# all = semua post menunggu persetujuan manusia (brief, 30 hari pertama); risky = hanya yang berisiko.
APPROVAL_MODE=all
# Pulse: satu post dari peristiwa nyata (graduation/launch Pons, harga Stock Token) paling cepat tiap PULSE_INTERVAL_MINUTES.
# Tidak ada topik baru = tidak ada post. Jenis antrian "pulse" harus ada di X_POST_KINDS agar terbit ke X.
PULSE_ENABLED=false
PULSE_INTERVAL_MINUTES=30

# LLM (provider PENDING; kosong = mock LLM). Isi dengan penyedia dan kredensial ELYSIA sendiri, bukan milik NEXA.
# LLM_PROVIDER=
# LLM_BASE_URL=
LLM_API_KEY=
# LLM_MODEL_SMALL=
# LLM_MODEL_LARGE=

# API
WEB_ORIGIN=http://localhost:3000
PAID_FEATURES_ENABLED=false
# Ask ELYSIA is free. Rate limit per IP (PENDING: temporary numbers, to be evaluated).
ASK_RATE_PER_MINUTE=10
ASK_RATE_PER_DAY=100
# Trusted reverse-proxy hops in front of the API. 0 = ignore X-Forwarded-For (safe default). Set to the real hop count behind a proxy, otherwise all clients share one IP.
TRUST_PROXY_HOPS=0

# Worker
# Kunci 32 byte hex untuk enkripsi preimage prediksi (salt). Buat: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PREIMAGE_KEY=
# Nama variabel warisan NEXA yang masih dibaca kode (worker/api); nama kontrak ledger ELYSIA masih PENDING. Diisi setelah deploy ELYSIA.
ELYSIA_LEDGER_ADDRESS=
# Diisi manusia langsung di dashboard Railway (service worker) / shell lokal. JANGAN pernah ditulis di file ini.
# AGENT_PRIVATE_KEY=

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_USE_FIXTURES=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Handle akun X Elysia tanpa "@" (diberikan developer 2026-11-13); jangan isi dengan handle NEXA
NEXT_PUBLIC_X_HANDLE=ElysiaSealed
# Hanya server: pilih varian fixture /proof ("populated" untuk dev/test pengikatan data)
FIXTURE_PROOF=

# Telegram (alert Pro + kanal cadangan). Diisi manusia; kosong = mode dry (hanya log)
TELEGRAM_BOT_TOKEN=
# Kanal cadangan PUBLIK (post yang sama dengan X, terkirim bersamaan; hanya di mode live)
TELEGRAM_CHAT_ID=
# Alert Pro: chat PRIBADI (kanal/grup privat), terkirim saat post disetujui, 15 menit lebih awal dari publik
TELEGRAM_PRO_CHAT_ID=

# Warisan NEXA (kontrak fee/burn bukan bagian jalur aktif ELYSIA; variabel dipertahankan karena kode lama masih membacanya).
PAIR_ASSET=
# Indexer (apps/indexer): warisan Pons V2/Robinhood; indexer launchpad Elysium menunggu alamat launchpad. Jangan set CHAIN_ENV=mainnet.
INDEXER_START_BLOCK=
INDEXER_CHUNK_BLOCKS=2000
INDEXER_POLL_SECONDS=5
HIGH_CREATOR_TAX_BPS=500
# Warisan NEXA, NONAKTIF: pembayaran Ask/Pro. ELYSIA gratis (Ask gratis; Pro dan Payment hanya placeholder "Soon"). POST /ask tidak membaca variabel ini.
# Dibiarkan kosong; nilai bawaan kode lama (Robinhood, USDG) sengaja tidak disalin ke sini.
ASK_PAYMENT_RECIPIENT=
# ASK_PRICE_USDG_MICROS=
# ASK_RPC_URL=
# PAYMENT_CHAIN_ID=
PAYMENT_USDG_ADDRESS=
PAYMENT_RPC_URL=
PRO_PAYMENT_RECIPIENT=
# PRO_PRICE_USDG_MICROS=
# PRO_DAYS=
# Laporan harian worker (warisan NEXA: Stock Token/Pons; butuh LLM_API_KEY): jam UTC paling awal laporan dibuat (masuk antrian persetujuan)
DAILY_SUMMARY_HOUR_UTC=13
PONS_REPORT_HOUR_UTC=15
# JSON [{"symbol":"NVDA","asset":"0x..","feed":"0x.."}] feed Chainlink Stock Token yang diringkas; kosong = Stock Token mainnet (NVDA)
SUMMARY_ASSETS=
# Selisih DEX vs oracle di ringkasan: pool Uniswap v4 aset/USDG terdalam dipilih otomatis. DEX_POOL_ID (0x + 64 heks) mengunci satu pool; kedalaman minimum dalam USDG
DEX_POOL_ID=
DEX_MIN_DEPTH_USDG=1000
# Selang snapshot harga oracle+DEX untuk kartu "Stock Token movers" (detik, min 60)
MARKET_INTERVAL_SECONDS=600
# Username bot Telegram ELYSIA (tanpa @; bot belum ada). Token bot tetap TELEGRAM_BOT_TOKEN (worker). Hanya satu worker yang boleh membaca update bot.
TELEGRAM_BOT_USERNAME=
# Harga LLM per 1 juta token dalam USD micro (1000000 = $1). Kosong = harga sementara MiMo v2.6 di apps/worker/src/llm.ts
LLM_PRICE_SMALL_IN_USD_MICROS=
LLM_PRICE_SMALL_OUT_USD_MICROS=
LLM_PRICE_LARGE_IN_USD_MICROS=
LLM_PRICE_LARGE_OUT_USD_MICROS=
# Warisan NEXA, NONAKTIF: alamat pembayaran Ask. Tidak ada Treasury dan Ask gratis; dibiarkan kosong.
NEXT_PUBLIC_ASK_PAYMENT_ADDRESS=
# Prediction of the Day (worker): jam UTC mulai dan aset (JSON). Feed aset harus terdaftar di kontrak ledger (setFeed). Kosong = tidak ada aset bawaan.
DAILY_PREDICTION_HOUR_UTC=9
PREDICTION_ASSETS=
# Warisan NEXA, NONAKTIF: benefit holder token (SIWE + kredit Ask). Ask ELYSIA gratis dan token ELYSIA ditunda. Dibiarkan kosong.
# Nama NEXA_TOKEN_ADDRESS dipertahankan karena apps/api/src/server.ts masih membacanya.
NEXA_TOKEN_ADDRESS=
# Warisan NEXA: pelacak burn. Burn hanya placeholder kosong sampai ada alamat kontrak resmi; tidak ada transaksi burn.
BURN_FROM_ADDRESS=
# BURN_MIN_NEXA=
HOLDER_THRESHOLD=
# HOLDER_FREE_ASKS_PER_MONTH=
# HOLDER_RPC_URL=
SESSION_TTL_HOURS=24
# Keeper harga TESTNET (worker): wallet Keeper ELYSIA sendiri (bukan Agent/Deployer) dengan sedikit HYPE testnet. Kosong = nonaktif.
# Diisi manusia saja (shell lokal/dashboard), JANGAN pernah di file ini.
KEEPER_PRIVATE_KEY=
KEEPER_FEEDS=
# ORACLE_RPC_URL=   # default kode lama = RPC Robinhood (di luar scope); isi RPC ELYSIA sendiri bila diperlukan
KEEPER_INTERVAL_SECONDS=300
# Indexer (warisan NEXA): konsentrasi holder, transfer whale, BurnVault (BurnVault tidak dipakai di jalur aktif ELYSIA)
HOLDER_CONCENTRATED_BPS=2000
HOLDER_TRACK_DAYS=7
WHALE_TOKENS=
WHALE_MIN_USD=100000
BURN_VAULT_ADDRESS=

# Explorer untuk link token di API. EXPLORER_URL tetap untuk link commit/tx. Default kode lama = explorer Robinhood (di luar scope); isi explorer ELYSIA bila perlu.
# TOKEN_EXPLORER_URL=

# ── SERVICE ELYSIUM TESTNET (apps/worker + apps/api untuk chain 99801) ───────
# Env ini hanya diisi di service Railway ELYSIA (project baru). Satu chain saja: Elysium Testnet.
# CHAIN_ID=99801
# RPC_URL=https://testnet-rpc.elysium.kinetiq.xyz
# EXPLORER_URL=https://elysium.kinetiq.xyz/testnet-explorer
# EXPLORER_TX_PATH=/transaction/
# ELYSIA_LEDGER_ADDRESS=                          # nama warisan; diisi setelah deploy ELYSIA (lihat docs/ELYSIA_BLOCKERS.md)
# FEED_HYPE_USD=                                # diisi setelah deploy
# FEED_ETH_USD=                                 # diisi setelah deploy
# X_POST_MODE=dry                               # tetap dry sampai ada izin tertulis
# APPROVAL_MODE=manual
# KEEPER_INTERVAL_SECONDS=300
# Aset prediksi Elysium: HYPE (mockAsset("HYPE"), diisi setelah deploy)
# PREDICTION_ASSETS=[{"symbol":"HYPE","asset":"<mockAsset-HYPE-address>"}]
# Token explorer Elysium (sama dengan EXPLORER_URL untuk Elysium)
# TOKEN_EXPLORER_URL=https://elysium.kinetiq.xyz/testnet-explorer

# ── WEB: pemilih chain (warisan multi-chain NEXA) ────────────────────────────
# ELYSIA hanya satu chain (Elysium Testnet). Dibiarkan kosong: chain picker disembunyikan.
NEXT_PUBLIC_API_URL_ELYSIUM=

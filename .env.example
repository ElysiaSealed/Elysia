# Elysia on Robinhood Chain mainnet (dev-rh). Only public values live in this file: never private keys, API keys or tokens.

# Wallets (public addresses only; provided by the developer on 2026-11-13)
DEPLOYER_ADDRESS=0x30E12875b1cc04cE06c4a889CDA435f475678D82
AGENT_ADDRESS=0x399c038d0946b358A94F3DDdeE64A87df051a9fC
# Receives Ask/Pro payments (USDG) when paid features are enabled.
TREASURY_ADDRESS=0x582660f6C3D5560D7797e1BC79DbB571Dd5a8121
# The Keeper wallet is not needed on mainnet: the ledger reads the Chainlink feeds directly.
KEEPER_ADDRESS=

# Chain: Robinhood Chain mainnet (4663). Defaults in code already point here; set explicitly in production.
CHAIN_ID=4663
CHAIN_ENV=mainnet
RPC_URL=https://rpc.mainnet.chain.robinhood.com
EXPLORER_URL=https://robinhoodchain.blockscout.com
EXPLORER_TX_PATH=/tx/
# Explorer used for token links in the API.
TOKEN_EXPLORER_URL=https://robinhoodchain.blockscout.com
# RPC used to read Chainlink feeds, Uniswap v4 and token data.
ORACLE_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Database (a new, dedicated Supabase project; free plan: keep egress and size small)
# Required, no default. Never reuse a database from another project.
DATABASE_URL=

# Posting
X_POST_MODE=dry
# X posting credentials (OAuth 1.0a) are only used when X_POST_MODE=live. Set them in the Railway dashboard, never in the repo.
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
# Lifetime cap of live posts in this database (0 = none; unlimited = no cap, enabled at launch).
X_LIVE_POST_CAP=0
# Minimum gap between live posts (minutes).
POST_INTERVAL_MINUTES=30
# Post kinds allowed to reach X, comma separated (empty = all): daily_summary, pons_report, pulse, prediction, mention_reply.
X_POST_KINDS=
# all = every post waits for human approval; risky = only risky posts.
APPROVAL_MODE=all
# Pulse: one post from a real event (Pons graduation/launch, Stock Token price) at most every PULSE_INTERVAL_MINUTES.
PULSE_ENABLED=false
PULSE_INTERVAL_MINUTES=30

# LLM (Xiaomi MiMo; empty key = mock LLM)
LLM_PROVIDER=mimo
LLM_BASE_URL=https://token-plan-sgp.xiaomimimo.com/v1
# Set the new Elysia key in the shell or dashboard, never in this file.
LLM_API_KEY=
LLM_MODEL_SMALL=mimo-v2.6-flash
LLM_MODEL_LARGE=mimo-v2.6-pro
# LLM price per 1M tokens in USD micro (1000000 = $1). Empty = provisional MiMo v2.6 prices in apps/worker/src/llm.ts.
LLM_PRICE_SMALL_IN_USD_MICROS=
LLM_PRICE_SMALL_OUT_USD_MICROS=
LLM_PRICE_LARGE_IN_USD_MICROS=
LLM_PRICE_LARGE_OUT_USD_MICROS=

# API
WEB_ORIGIN=http://localhost:3000
# Paid features (Pro, Ask, Signals API, Sponsored). Keep false until payments are verified end to end.
PAID_FEATURES_ENABLED=false
# Ask rate limit per IP (temporary numbers, to be evaluated).
ASK_RATE_PER_MINUTE=10
ASK_RATE_PER_DAY=100
# Supabase free plan budget: egress under 150 MB per day (limit 5 GB per month) and database under 500 MB.
# Public read endpoints are served from memory: base window in seconds (scoreboard x2.5, price snapshots x5, one prediction x30).
PUBLIC_CACHE_SECONDS=120
# Cap on all free Ask requests per UTC day, from every IP together.
ASK_GLOBAL_PER_DAY=2000
# Trusted reverse-proxy hops in front of the API. 0 = ignore X-Forwarded-For. Set the real hop count behind a proxy, otherwise all clients share one IP.
TRUST_PROXY_HOPS=0
SESSION_TTL_HOURS=24

# Payments (USDG on mainnet; the official USDG address is taken from packages/shared/src/chains.ts when these are empty)
# ASK_PAYMENT_RECIPIENT defaults to TREASURY_ADDRESS.
ASK_PAYMENT_RECIPIENT=
# Prices are USDG micros (1000000 = $1) and are shown by GET /pricing, so editing them needs no redeploy of the web.
# Temporary values agreed on 2026-11-13: Pro $5 per 30 days, Ask free, Signals API $499 per 30 days, Sponsored report $750.
ASK_PRICE_USDG_MICROS=0
# ASK_RPC_URL=https://rpc.mainnet.chain.robinhood.com
# PAYMENT_CHAIN_ID=4663
PAYMENT_USDG_ADDRESS=
PAYMENT_RPC_URL=
PRO_PAYMENT_RECIPIENT=
PRO_PRICE_USDG_MICROS=5000000
PRO_DAYS=30
# Signals API and Sponsored reports are sold by contact (the API key is issued after payment); only the price is shown.
SIGNALS_PRICE_USDG_MICROS=499000000
SIGNALS_PERIOD_DAYS=30
SPONSORED_PRICE_USDG_MICROS=750000000
NEXT_PUBLIC_ASK_PAYMENT_ADDRESS=

# $ELYS token holder benefits (SIWE + free Ask credits). Empty = disabled until the token exists.
ELYS_TOKEN_ADDRESS=
HOLDER_THRESHOLD=
# HOLDER_FREE_ASKS_PER_MONTH=
# HOLDER_RPC_URL=

# Worker
# 32-byte hex key that encrypts prediction preimages (salt). Create: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PREIMAGE_KEY=
# ElysiaLedger address: filled after the approved deploy.
ELYSIA_LEDGER_ADDRESS=0x89D5E9A903af6dA38977BaD6954E0Bd380429B53
# Set by a human in the Railway dashboard or local shell. Never write it in this file.
# AGENT_PRIVATE_KEY=
# Prediction of the Day: start hour (UTC) and assets (JSON). Empty assets = mainnet NVDA and WETH from the code.
DAILY_PREDICTION_HOUR_UTC=9
PREDICTION_ASSETS=
# Daily reports: earliest UTC hour (they enter the approval queue; needs LLM_API_KEY)
DAILY_SUMMARY_HOUR_UTC=13
PONS_REPORT_HOUR_UTC=15
# JSON [{"symbol":"NVDA","asset":"0x..","feed":"0x.."}] Chainlink Stock Token feeds to summarize; empty = mainnet Stock Token (NVDA)
SUMMARY_ASSETS=
# DEX vs oracle spread: the deepest Uniswap v4 asset/USDG pool is picked automatically. DEX_POOL_ID (0x + 64 hex) pins one pool; minimum depth in USDG.
DEX_POOL_ID=
DEX_MIN_DEPTH_USDG=1000
# Oracle + DEX price snapshot interval for the "Stock Token movers" card (seconds, min 60)
MARKET_INTERVAL_SECONDS=600
# Telegram bot username (without @). Only one worker may read bot updates.
TELEGRAM_BOT_USERNAME=ElysiaSealedBot
# Testnet-only price keeper (mirrors Chainlink prices into mock feeds). Not used on mainnet.
KEEPER_PRIVATE_KEY=
KEEPER_FEEDS=
KEEPER_INTERVAL_SECONDS=300

# Telegram (Pro alerts and a public backup channel). Set by a human; empty = dry mode (log only)
TELEGRAM_BOT_TOKEN=
# Public backup channel (same posts as X, sent together; live mode only)
TELEGRAM_CHAT_ID=
# Pro alerts: PRIVATE chat, sent when a post is approved, 15 minutes before the public one
TELEGRAM_PRO_CHAT_ID=

# Indexer (apps/indexer): Pons V2 launches/graduations, holder concentration, whale transfers, burn history
PAIR_ASSET=
INDEXER_START_BLOCK=
INDEXER_CHUNK_BLOCKS=2000
INDEXER_POLL_SECONDS=10
# Housekeeping (worker, once a day): retention of derived data in days, and database size thresholds in MB.
# The indexer pauses ingestion at DB_SIZE_LIMIT_MB so the database never reaches the 500 MB read-only limit.
RETAIN_TRADES_DAYS=30
RETAIN_WHALES_DAYS=30
RETAIN_SNAPSHOTS_DAYS=7
RETAIN_ALERTS_DAYS=30
DB_SIZE_WARN_MB=350
DB_SIZE_LIMIT_MB=420
HIGH_CREATOR_TAX_BPS=500
HOLDER_CONCENTRATED_BPS=2000
HOLDER_TRACK_DAYS=7
WHALE_TOKENS=
WHALE_MIN_USD=100000
# Burn history is read from the contract address provided by the PM (event signature pending).
BURN_CONTRACT_ADDRESS=
BURN_FROM_ADDRESS=
# BURN_MIN_ELYS=

# Web (apps/web)
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_USE_FIXTURES=true
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# X handle without "@" (provided by the developer on 2026-11-13)
NEXT_PUBLIC_X_HANDLE=ElysiaSealed
# Public Telegram channel shown in the footer
NEXT_PUBLIC_TELEGRAM_URL=https://t.me/ElysiaAlert
# $ELYS contract address from the PM. Empty = nothing is shown. Hero, footer and Burn tracker show it and link to the Robinhood Chain explorer.
NEXT_PUBLIC_ELYSIA_CA=
# Server only: /proof fixture variant ("populated" to test data binding)
FIXTURE_PROOF=
